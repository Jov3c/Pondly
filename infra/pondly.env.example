# Copy to /etc/pondly/pondly.env, chmod 0600, and replace placeholders.
# Never commit real credentials or secret keys.
PONDLY_DATABASE_URL=postgres://pondly_runtime:CHANGE_ME@127.0.0.1:5432/pondly?sslmode=require
PONDLY_REDIS_URL=redis://default:CHANGE_ME@127.0.0.1:6379/0
PONDLY_LISTEN_ADDR=127.0.0.1:8080
PONDLY_ADMIN_LISTEN_ADDR=127.0.0.1:8081
PONDLY_CURSOR_KEY=CHANGE_ME_BASE64_32_BYTES
PONDLY_SECRET_REPLAY_KEY=CHANGE_ME_BASE64_32_BYTES
PONDLY_SMTP_HOST=smtp.example.invalid
PONDLY_SMTP_PORT=587
PONDLY_SMTP_USERNAME=CHANGE_ME
PONDLY_SMTP_PASSWORD=CHANGE_ME
PONDLY_SMTP_FROM=pondly@example.invalid
PONDLY_COOKIE_SECURE=true
PONDLY_PILOT_MODE=true
# CIDRs allowed to set X-Forwarded-For: every host between a browser and this
# API, so the web app's proxy address belongs here too. Empty means the socket
# address is authoritative and the header is ignored, which puts every owner
# behind one shared bucket when a loopback proxy fronts the API. Required before
# a public deployment; see docs/08-operations.md.
PONDLY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# OTP send protection (defaults shown). Daily buckets are rolling 24h windows.
PONDLY_AUTH_START_COOLDOWN=60s
PONDLY_AUTH_DAILY_PER_IP=50
PONDLY_AUTH_DAILY_PER_EMAIL=5
# Standalone rule review bot (pondly-moderator); dev starts its own 5s loop.
PONDLY_MODERATION_INTERVAL=10s
PONDLY_MODERATION_BATCH=50
